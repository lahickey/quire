package ui

import "github.com/lahickey/quire/model"

templ img(im model.Image, alt string, a templ.Attributes) {
	if im.Src() != "" {
		<img { a... } alt={ alt }/>
	}
}

templ priorityImg(im model.Image, slot model.Slot, alt string) {
	@img(im, alt, im.PriorityAttrs(slot))
}

templ Img(im model.Image, slot model.Slot, alt string) {
	@img(im, alt, im.Attrs(slot))
}

templ LazyFigure(im model.Image, alt, caption string) {
	if im.Hash != "" {
		<figure class="figure">
			@Img(im, model.SlotPage, alt)
			if caption != "" {
				<figcaption>{ caption }</figcaption>
			}
		</figure>
	}
}
