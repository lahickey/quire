package ui

import "github.com/lahickey/quire/model"

templ figure(im model.Image, slot model.Slot, alt, caption string, priority bool) {
	if im.Hash != "" {
		<figure class={ figureClass(slot) }>
			<img { im.Attrs(slot, priority)... } alt={ alt }/>
			if caption != "" {
				<figcaption>{ caption }</figcaption>
			}
		</figure>
	}
}

templ Img(im model.Image, slot model.Slot, alt string) {
	if im.Hash != "" {
		<img { im.Attrs(slot, false)... } alt={ alt }/>
	}
}

templ LazyFigure(im model.Image, alt, caption string) {
	@figure(im, model.SlotPage, alt, caption, false)
}

templ HeroFigure(im model.Image, slot model.Slot, alt, caption string) {
	@figure(im, slot, alt, caption, true)
}
