package ui

import "github.com/lahickey/quire/model"

templ Img(im model.Image, slot model.Slot, alt string) {
	@pictureOf(im, slot, alt, im.Attrs(slot))
}

templ priorityImg(im model.Image, slot model.Slot, alt string) {
	@pictureOf(im, slot, alt, im.PriorityAttrs(slot))
}

templ pictureOf(im model.Image, slot model.Slot, alt string, a templ.Attributes) {
	if im.Src() != "" {
		if srcs := im.Sources(slot); len(srcs) > 0 {
			<picture>
				for _, src := range srcs {
					<source { src... }/>
				}
				<img { a... } alt={ alt }/>
			</picture>
		} else {
			<img { a... } alt={ alt }/>
		}
	}
}

templ LazyFigure(im model.Image, alt, caption string) {
	if im.Hash != "" {
		<figure class="figure">
			@Img(im, model.SlotPage, alt)
			if caption != "" {
				<figcaption>{ caption }</figcaption>
			}
		</figure>
	}
}
