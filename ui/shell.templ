package ui

import (
	"fmt"
	"github.com/lahickey/quire/model"
)

templ styles(c model.Chrome) {
	for _, u := range c.FontPreload {
		<link rel="preload" href={ u } as="font" type="font/woff2" crossorigin/>
	}
	for _, h := range c.StyleURLs {
		<link rel="stylesheet" href={ h }/>
	}
}

templ head(c model.Chrome, p model.PageSpec) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="color-scheme" content={ c.Theme.String() }/>
	@scripts(c)
	@styles(c)
	<title>{ p.Title }</title>
	<meta name="description" content={ p.MetaDescription(c) }/>
	if c.Author != "" {
		<meta name="author" content={ c.Author }/>
	}
	if c := p.Canonical(c); c != "" {
		<link rel="canonical" href={ c }/>
	} else {
		<meta name="robots" content="noindex"/>
	}
	if p.Article != nil && p.Article.Published != "" {
		<meta property="og:type" content="article"/>
		<meta property="article:published_time" content={ p.Article.Published }/>
		if p.Article.Modified != "" {
			<meta property="article:modified_time" content={ p.Article.Modified }/>
		}
	} else {
		<meta property="og:type" content="website"/>
	}
	if c := p.Canonical(c); c != "" {
		<meta property="og:url" content={ c }/>
	}
	<meta property="og:title" content={ p.Title }/>
	<meta property="og:description" content={ p.MetaDescription(c) }/>
	<meta property="og:image" content={ p.OGImage(c) }/>
	<meta property="og:site_name" content={ c.Name }/>
	<meta name="twitter:card" content="summary_large_image"/>
	<meta name="twitter:title" content={ p.Title }/>
	<meta name="twitter:description" content={ p.MetaDescription(c) }/>
	<meta name="twitter:image" content={ p.OGImage(c) }/>
	for _, i := range c.Icons {
		<link { i.Attrs()... }/>
	}
}

templ scripts(c model.Chrome) {
	if c.ScriptURL != "" {
		<script src={ c.ScriptURL }></script>
	}
	for _, m := range c.ModuleURLs {
		<script type="module" src={ m }></script>
	}
}

templ ThemeToggle() {
	<button type="button" class="theme-toggle" data-on:click__viewtransition={ toggleTheme } aria-label="Toggle theme" title="Toggle theme">
		<svg class="theme-toggle-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="5"></circle>
			<line x1="12" y1="1" x2="12" y2="3"></line>
			<line x1="12" y1="21" x2="12" y2="23"></line>
			<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
			<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
			<line x1="1" y1="12" x2="3" y2="12"></line>
			<line x1="21" y1="12" x2="23" y2="12"></line>
			<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
			<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
		</svg>
		<svg class="theme-toggle-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
		</svg>
	</button>
}

templ snippet(c model.Chrome) {
	if r := c.LiveReload; r.On {
		<div
			style="display:none"
			data-signals={ fmt.Sprintf("{quire: {boot: %q}}", r.BootID) }
			data-effect={ fmt.Sprintf("$quire.boot !== %q && window.location.reload()", r.BootID) }
			data-init={ r.Init }
		></div>
	}
}

templ Nav(c model.Chrome, p model.PageSpec) {
	if c.Brand != "" {
		<a href="/" class="nav-brand">{ c.Brand }</a>
	}
	for _, it := range c.Nav {
		if c.Brand == "" || it.Href != "/" {
			<a href={ it.Href } class={ navClass(p.Path, it.Href) }>{ it.Label }</a>
		}
	}
}

templ Header(c model.Chrome, p model.PageSpec) {
	<header class="site-header">
		<nav class="site-nav" aria-label="Main navigation">
			<div class="nav-links">
				@Nav(c, p)
			</div>
			<div class="nav-end">
				for _, control := range c.NavEnd {
					@control
				}
				@ThemeToggle()
			</div>
		</nav>
	</header>
}

templ Footer(c model.Chrome, p model.PageSpec) {
	<footer class="site-footer">
		<div class="footer-inner">
			<span>© { CurrentYear() } { c.Name }</span>
		</div>
	</footer>
}

templ Shell(c model.Chrome, p model.PageSpec) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ c.Theme.String() }>
		<head>
			@head(c, p)
		</head>
		<body>
			@snippet(c)
			@c.Header(c, p)
			<main>
				{ children... }
			</main>
			@c.Footer(c, p)
		</body>
	</html>
}
