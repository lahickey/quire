# Lexis, the highlighter. From the repo root `just lexis` lists these.
root := source_directory() / "../.."

_default:
    @just --justfile {{ source_file() }} --list

# Run Lexis's tests.
test:
    cd {{ source_directory() }} && go test ./...

# Set Lexis beside Chroma for speed and agreement, and write the docs page of the results.
bench:
    cd {{ source_directory() }}/bench && go run . {{ root }}/site/content/docs/benchmarks.md

# List the text Lexis and Chroma disagree on in a language: `just lexis diff go`.
diff language:
    @cd {{ source_directory() }}/bench && go run . diff {{ language }}

shown := "30"
source := "https://github.com/lahickey/quire/blob/master/libs/lexis/_corpus"

# Write the docs page that shows the start of each language's file in the corpus, highlighted.
languages:
    #!/usr/bin/env sh
    set -eu
    cd {{ source_directory() }}/_corpus
    {
        printf '%s\n' '---' 'title: Lexis languages' 'summary: Every language Lexis has, as Lexis colours it.' '---' ''
        printf '%s\n' 'Every language [Lexis](./lexis.md) comes with, each as the first {{ shown }} lines of its file in the corpus at `libs/lexis/_corpus`.' \
            '`just lexis languages` writes this page from those files, which are also what the tests and [the benchmarks](./benchmarks.md) read.' \
            'It is here to be looked over: a colour in the wrong place is a fault in that language'"'"'s lexer.'
        for dir in */; do
            name=${dir%/}
            file=$(ls "$name")
            printf '\n## %s\n\n[`%s`]({{ source }}/%s/%s), from the top.\n\n<div data-nosearch>\n\n`````%s\n' "$name" "$file" "$name" "$file" "$name"
            head -n {{ shown }} "$name/$file"
            printf '`````\n\n</div>\n'
        done
    } > {{ root }}/site/content/docs/languages.md

# Write both generated docs pages: the benchmarks and the languages.
docs: bench languages
