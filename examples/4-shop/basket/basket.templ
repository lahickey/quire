package basket

import "strconv"

// The nav link, on every page. data-signals holds the count in the browser,
// data-init opens the event stream, and data-text shows the count as it changes.
templ (p *Feature) nav() {
	<a class="basket-link" href={ p.at } data-signals={ p.streams.Signals(map[string]int{"count": 0}) } data-init={ p.streams.Listen("events") }>
		Basket
		<span class="basket-count" data-text="$basket.count">0</span>
	</a>
}

// A form that posts normally, and through Datastar once it has loaded.
templ (p *Feature) button(endpoint, id, label string) {
	@p.streams.Form(endpoint) {
		<input type="hidden" name="item" value={ id }/>
		<button type="submit">{ label }</button>
	}
}

// The basket's contents. Its id lets the event stream replace it in place.
templ (p *Feature) lines(cart map[string]int) {
	<div id="basket-body">
		if len(cart) == 0 {
			<p class="page-intro">Nothing in it.</p>
		} else {
			<ul class="basket-lines">
				for _, it := range p.items {
					if cart[it.ID] > 0 {
						<li class="basket-line">
							<span class="basket-title">{ it.Title }</span>
							@p.button("dec", it.ID, "−")
							<span class="basket-qty">{ strconv.Itoa(cart[it.ID]) }</span>
							@p.button("add", it.ID, "+")
							<span class="basket-price">{ (it.Price * Money(cart[it.ID])).String() }</span>
						</li>
					}
				}
			</ul>
			<p class="basket-total">Total <span class="basket-price">{ p.total(cart).String() }</span></p>
		}
	</div>
}

// The body of the basket page.
templ (p *Feature) page(cart map[string]int) {
	<article class="page" data-init={ p.streams.Listen("events?view=lines") }>
		<header class="page-head"><h1>Basket</h1></header>
		@p.lines(cart)
	</article>
}

// Add is the price and the button a site places on an item's page.
templ (p *Feature) Add(id string) {
	<div class="basket-add">
		for _, it := range p.items {
			if it.ID == id {
				<span class="basket-price">{ it.Price.String() }</span>
			}
		}
		@p.button("add", id, "Add to basket")
	</div>
}

// Every basket there is, for whoever runs the shop.
templ (p *Feature) baskets(rows []row) {
	<article class="page">
		<header class="page-head"><h1>Baskets</h1></header>
		if len(rows) == 0 {
			<p class="page-intro">Nobody has anything in one.</p>
		} else {
			<ul class="basket-lines">
				for _, r := range rows {
					<li class="basket-line">
						<span class="basket-title">{ r.visitor }</span>
						<span class="basket-qty">{ strconv.Itoa(r.count) }</span>
					</li>
				}
			</ul>
		}
	</article>
}
