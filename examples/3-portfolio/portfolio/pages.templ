package portfolio

import "github.com/lahickey/quire/model"
import "github.com/lahickey/quire/pack/base/ui"

// Replaces the default footer on every page.
templ siteFooter(model.Chrome, model.PageSpec) {
	<footer class="site-footer"><span>Written and built by A. Writer.</span></footer>
}

// A page is a body. The site puts it in the document and the frame, given its
// head data where the page is added.
templ homePage(notes, projects *model.Collection) {
	<article class="page page--wide">
		<h1>Writing</h1>
		<p class="home-intro">Notes on building things, and the things built.</p>
		@ui.CardGrid(append(ui.DocCards(ctx, notes, notes.Docs()), ui.DocCards(ctx, projects, projects.Docs())...))
	</article>
}

// The contact page: a heading and a button of the site's own, round words that
// come from markdown.
templ contactPage(words templ.Component) {
	<article class="page">
		<header class="page-head">
			<h1>Get in touch</h1>
			<div class="btn-row">
				<a href="mailto:writer@example.com" class="btn-primary">writer@example.com</a>
			</div>
		</header>
		<div class="prose">
			@words
		</div>
	</article>
}

// Served with a 404 for any path the site does not have.
templ notFoundPage() {
	<article class="page">
		<h1>Nothing here</h1>
		<p class="home-intro">That page was never written, or has moved. The <a href="/writing">writing</a> is all still there.</p>
	</article>
}
