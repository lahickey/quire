package searchui

import "github.com/lahickey/quire/feature/search"

// The nav control. Typing fetches the results, which replace #search-live;
// without JavaScript, submitting the form loads the results page instead.
templ box(action, live string) {
	<form
		class="search-box"
		role="search"
		method="get"
		action={ action }
		data-on:input__debounce.150ms={ "@get('" + live + "', {contentType: 'form'})" }
	>
		<input
			class="search-input"
			type="search"
			name="q"
			placeholder="Search  /"
			aria-label="Search"
			autocomplete="off"
			data-on:keydown__window="evt.key === '/' && !evt.target.closest('input, textarea, select') && (evt.preventDefault(), el.focus())"
		/>
		@results("", nil)
	</form>
}

templ hits(hs []search.Hit) {
	<ul class="search-hits">
		for _, h := range hs {
			<li>
				<a class="search-hit" href={ h.URL }>
					<span class="search-hit-title">
						{ h.Page }
						if h.Heading != "" {
							<span class="search-hit-sep">›</span> { h.Heading }
						}
					</span>
					<span class="search-hit-text">{ h.Before }<mark>{ h.Match }</mark>{ h.After }</span>
				</a>
			</li>
		}
	</ul>
}

templ answer(q string, hs []search.Hit) {
	if len(hs) > 0 {
		@hits(hs)
	} else if q != "" {
		<p class="search-none">Nothing found for “{ q }”.</p>
	}
}

templ results(q string, hs []search.Hit) {
	<div id="search-live" class="search-live">
		@answer(q, hs)
	</div>
}

templ page(q string, hs []search.Hit) {
	<article class="page">
		<header class="page-head">
			<h1>Search</h1>
			if q != "" {
				<p class="page-intro">Results for “{ q }”.</p>
			}
		</header>
		<div class="search-page">
			@answer(q, hs)
		</div>
	</article>
}
