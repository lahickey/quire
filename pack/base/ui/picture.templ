package ui

import "github.com/lahickey/quire/model"

templ figure(pic model.Picture, size model.Size, alt, caption string, priority bool) {
	if pic.Hash != "" {
		<figure class={ figureClass(size) }>
			<img { scale(ctx).Attrs(pic, size, priority)... } alt={ alt }/>
			if caption != "" {
				<figcaption>{ caption }</figcaption>
			}
		</figure>
	}
}

templ VideoFigure(src string, poster model.Picture, alt, caption string) {
	<figure class="figure">
		<video
			src={ src }
			poster={ scale(ctx).URL(poster, model.SizePage) }
			width={ poster.Width }
			height={ poster.Height }
			aria-label={ alt }
			preload="none"
			controls
			loop
			muted
			playsinline
		></video>
		if caption != "" {
			<figcaption>{ caption }</figcaption>
		}
	</figure>
}

templ Img(pic model.Picture, size model.Size, alt string) {
	if pic.Hash != "" {
		<img { scale(ctx).Attrs(pic, size, false)... } alt={ alt }/>
	}
}

templ LazyFigure(pic model.Picture, alt, caption string) {
	@figure(pic, model.SizePage, alt, caption, false)
}

templ HeroFigure(pic model.Picture, size model.Size, alt, caption string) {
	@figure(pic, size, alt, caption, true)
}
