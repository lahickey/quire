func linkIcon(raw string) string {
	u, err := url.Parse(raw)
	if err != nil {
		return ""
	}
	return linkIcons[strings.TrimPrefix(u.Hostname(), "www.")]
}

templ Link(l model.Link, class string) {
	{{ mark := linkIcon(l.URL) }}
	<a
		href={ l.URL }
		if mark != "" {
			title={ l.Label }
		}
		class={ templ.KV(class, l.Badge == ""), templ.KV("link-badge", l.Badge != "") }
		if strings.Contains(l.URL, "://") {
			target="_blank"
			rel="external noopener noreferrer"
		}
	>
		if l.Badge != "" {
			<img src={ l.Badge } alt={ l.Label }/>
		} else {
			if mark != "" {
				<svg class="link-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ mark }></path></svg>
				<span class="link-label">{ l.Label }</span>
			} else {
				{ l.Label }
			}
		}
	</a>
}

templ Tags(ts []model.Marker) {
	if len(ts) > 0 {
		<div class="tags-list">
			for _, t := range ts {
				@tag(t)
			}
		</div>
	}
}

templ CardGrid(cards []CardData) {
	<div class="card-grid">
		for _, c := range cards {
			@Card(c)
		}
	</div>
}

// Cards is a grid of cards, one for each of a collection's documents given.
templ Cards(c *model.Collection, docs []model.Document) {
	@CardGrid(DocCards(ctx, c, docs))
}

templ Card(c CardData) {
	<a href={ c.Href } class="card">
		if c.Picture.Hash != "" {
			<div class="card-picture">
				@Img(c.Picture, model.SizeColumn, c.Title)
			</div>
		}
		if c.Draft || c.Featured || len(c.Badges) > 0 {
			<div class="card-badges">
				if c.Featured {
					<span class="featured-badge">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
						Featured
					</span>
				}
				if c.Draft {
					@DraftBadge()
				}
				@Badges(c.Badges)
			</div>
		}
		<span class="card-kicker">{ c.Kicker }</span>
		<h3 class="card-title">{ c.Title }</h3>
		<p class="card-description">{ c.Description }</p>
		if len(c.Tags) > 0 {
			<div class="tags-list">
				for _, t := range c.Tags {
					@tag(t)
				}
				if e := c.extra(); e != "" {
					<span class="tag-more">{ e }</span>
				}
			</div>
		}
		if c.CTA != "" {
			@ForwardLink(c.CTA, "", "accent")
		}
	</a>
}

templ BackLink(href, text string) {
	<p class="back-link">
		<a href={ href }><span class="arrow">←</span> { text }</a>
	</p>
}

templ ForwardLink(text, href, variant string) {
	if href != "" {
		<a href={ href } class={ "forward-link", "forward-link--" + variant }>
			{ text } <span class="arrow">→</span>
		</a>
	} else {
		<span class={ "forward-link", "forward-link--" + variant }>
			{ text } <span class="arrow">→</span>
		</span>
	}
}

templ Pager(c *model.Collection, d model.Document) {
	{{ prev, next := c.Neighbours(d) }}
	<nav class="pager" aria-label="Previous and next page">
		if prev != nil {
			<a class="pager-link" href={ c.Href(*prev) }>
				<span class="kicker">Previous</span>
				{ prev.Meta.Title }
			</a>
		}
		if next != nil {
			<a class="pager-link pager-link--next" href={ c.Href(*next) }>
				<span class="kicker">Next</span>
				{ next.Meta.Title }
			</a>
		}
	</nav>
}
