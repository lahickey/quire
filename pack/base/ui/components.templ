package ui

import (
	"context"
	"github.com/lahickey/quire/model"
	"net/url"
	"strconv"
	"strings"
)

type CardData struct {
	Href, Kicker, Title, Description, CTA string
	Draft, Featured                       bool
	Picture                               model.Picture
	Badges                                []model.Marker
	Tags                                  []model.Marker
	Extra                                 int
}

func tocItemClass(h model.Heading) string {
	return "toc-item toc-item--depth-" + strconv.Itoa(h.Level)
}

func toc(heads []model.Heading) []model.Heading {
	var out []model.Heading
	for _, h := range heads {
		if h.Level == 2 || h.Level == 3 {
			out = append(out, h)
		}
	}
	return out
}

func (c CardData) extra() string {
	if c.Extra <= 0 {
		return ""
	}
	return "+" + strconv.Itoa(c.Extra)
}

templ tag(t model.Marker) {
	<span class={ "tag", templ.KV("tag-"+t.Kind, t.Kind != "") }>{ t.Text }</span>
}

func DocCard(ctx context.Context, c *model.Collection, d model.Document) CardData {
	return CardData{
		Href:        c.Href(d),
		Kicker:      MonthYear(ctx, d.Meta.Date),
		Title:       d.Meta.Title,
		Description: d.Meta.Summary,
		Draft:       d.Meta.Draft,
		Featured:    d.Meta.Featured,
		Picture:     d.Picture,
		Badges:      c.Badges(d),
		Tags:        c.Tags(d),
	}
}

// DocCards is a card for each of a collection's documents given.
func DocCards(ctx context.Context, c *model.Collection, docs []model.Document) []CardData {
	out := make([]CardData, len(docs))
	for i, d := range docs {
		out[i] = DocCard(ctx, c, d)
	}
	return out
}

templ DraftBadge() {
	<span class="status-badge status-badge--draft">Draft</span>
}

templ Badges(bs []model.Marker) {
	for _, b := range bs {
		<span class={ "status-badge", "status-badge--" + b.Kind }>{ b.Text }</span>
	}
}

templ Contents(heads []model.Heading) {
	{{ items := toc(heads) }}
	if len(items) >= 3 {
		<nav class="toc" aria-label="Table of contents">
			<details>
				<summary class="toc-toggle">
					<span class="toc-title">Table of Contents</span>
					<span class="toc-count">{ strconv.Itoa(len(items)) + " sections" }</span>
					<svg class="toc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="6 9 12 15 18 9"></polyline>
					</svg>
				</summary>
				<ul class="toc-list">
					for _, h := range items {
						<li class={ tocItemClass(h) }>
							<a href={ "#" + h.ID } class="toc-link">{ h.Text }</a>
						</li>
					}
				</ul>
			</details>
		</nav>
	}
}

